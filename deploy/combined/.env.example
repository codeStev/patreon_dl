# Copy to .env (in this directory) and adjust before `docker compose up`.

DB_PASSWORD=changeme

# Leave IMAP_HOST empty to disable email polling entirely.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

REGISTRY_HOST=
IMAGE_TAG=latest

# See "Setting up downloads" in the README before setting these - rclone
# needs a one-time interactive `rclone config` on your own machine first.
# DOWNLOAD_PATH is where actual files land - point it at your real HDD.
# RCLONE_CONFIG_PATH must exist as a FILE before the first `docker compose
# up` (an absent path gets bind-mounted as an empty directory instead,
# which breaks rclone confusingly) - `touch` it first if you haven't run
# `rclone config` yet.
DOWNLOAD_PATH=./downloads
RCLONE_CONFIG_PATH=./rclone.conf
RCLONE_REMOTE_NAME=gdrive

# Safe defaults for a stranger cloning this repo - bind to localhost only.
# Widen only if you know your own network boundary handles exposure.
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
